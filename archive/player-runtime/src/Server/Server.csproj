<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- The WebUI dist is plain Content copied into the output/publish wwwroot, and Program.cs pins
         the web root to AppContext.BaseDirectory, so the static-web-assets pipeline adds nothing.
         Its .NET 10 dev manifest instead anchors the assets at src/Server/wwwroot and crashes the
         WebApplicationFactory test host (DirectoryNotFoundException) when that directory is absent. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Kernel/Kernel.csproj" />
    <ProjectReference Include="../Spatial/Spatial.csproj" />
    <ProjectReference Include="../Protocol/Protocol.csproj" />
    <ProjectReference Include="../Player/Player.csproj" />
    <ProjectReference Include="../Decision.Validation/Decision.Validation.csproj" />
    <ProjectReference Include="../Player.Agency/Player.Agency.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../WebUI/dist/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
