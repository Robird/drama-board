<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../Kernel/Kernel.csproj" />
    <ProjectReference Include="../Spatial/Spatial.csproj" />
    <ProjectReference Include="../Protocol/Protocol.csproj" />
    <ProjectReference Include="../Player/Player.csproj" />
    <ProjectReference Include="../Decision.Validation/Decision.Validation.csproj" />
    <ProjectReference Include="../Player.Agency/Player.Agency.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../WebUI/dist/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- .NET 10 static web assets anchor dist assets at $(MSBuildProjectDirectory)\wwwroot and the
       test host fails with DirectoryNotFoundException when that directory does not exist. An empty
       directory is enough: dev serving uses bin\wwwroot and publish uses publish\wwwroot. -->
  <Target Name="EnsureWwwrootDirectory" BeforeTargets="Build">
    <MakeDir Directories="$(MSBuildThisFileDirectory)wwwroot" />
  </Target>
</Project>
