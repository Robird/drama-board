<Project>
  <PropertyGroup>
    <DurableGraphPackageVersion>0.0.0-dramaboard.20261027.gc549124.1</DurableGraphPackageVersion>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.Config</RestoreConfigFile>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)artifacts/nuget-packages</RestorePackagesPath>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DramaBoard.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>DramaBoard.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>
</Project>
