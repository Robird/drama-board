<Project>
  <PropertyGroup>
    <DurableGraphPackageVersion>0.0.0-dramaboard.20260912.1c6083c.1</DurableGraphPackageVersion>
    <DurableGraphPackageSource Condition="'$(DurableGraphPackageSource)' == ''">$(MSBuildThisFileDirectory)artifacts/durablegraph-integration/feed</DurableGraphPackageSource>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(DurableGraphPackageSource)</RestoreAdditionalProjectSources>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DramaBoard.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>DramaBoard.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>
</Project>
